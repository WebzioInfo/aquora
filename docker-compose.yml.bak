version: '3.8'

services:
  redis:
    image: redis:7-alpine
    container_name: flowmes-redis
    ports:
      - "6379:6379"

  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    container_name: aquora-backend
    ports:
      - "5000:80"
    environment:
      - ConnectionStrings__DefaultConnection=Host=aws-1-ap-northeast-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.lxwherkjkjuhmfqzrziw;Password=${SUPABASE_DB_PASSWORD:-aquoradb@2026};SSL Mode=Require;Trust Server Certificate=true;CommandTimeout=120;
      - ConnectionStrings__RedisConnection=redis:6379
      - JwtSettings__Secret=AquoraSuperSecretKeyPlaceholderForLocalDev123!
      - JwtSettings__Issuer=Aquora
      - JwtSettings__Audience=AquoraClients
      - JwtSettings__DurationInMinutes=60
    depends_on:
      - redis

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
    container_name: aquora-frontend
    ports:
      - "5173:80"
    depends_on:
      - backend
