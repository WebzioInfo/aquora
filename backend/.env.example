# AQUORA ERP — Backend Environment Variable Template (.env.example)
# DO NOT ADD REAL SECRETS TO THIS FILE.

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# Database Configuration (PostgreSQL / Supabase)
ConnectionStrings__DefaultConnection=Host=your-db-host;Port=5432;Database=postgres;Username=postgres;Password=your_password;SSL Mode=Require;Trust Server Certificate=true;CommandTimeout=120;
POSTGRES_CONNECTION=
DATABASE_URL=

# JWT Authentication
JwtSettings__Secret=YOUR_PRODUCTION_JWT_SUPER_SECRET_KEY_MIN_32_CHARS
JWT_SECRET=

# SMTP / Email Configuration (Mailtrap / SendGrid / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_PASS=
SMTP_FROM_NAME=Aquora ERP

# CORS & Allowed Origins
FRONTEND_URL=https://aquora.webziointernational.in
ALLOWED_ORIGINS=https://aquora.webziointernational.in,https://aquora-webzio.vercel.app

# Backup Passphrase
BackupSettings__Passphrase=YOUR_ENTERPRISE_BACKUP_PASSPHRASE
